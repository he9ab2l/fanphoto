# FanPhoto 环境变量模板。复制为 `.env` 后填写；两种方式初始化：
#   1. `pnpm setup` 自动生成 `.env` 并写出管理员凭据（推荐，拒绝覆盖已有配置）
#   2. 手动 `cp .env.example .env` 后按需修改
# `.env` 与任何真实凭据文件均不入 Git（见 .gitignore）。

# 唯一站点 origin，影响 Cookie Secure/SameSite 与同源校验。生产必须为 https 外网地址。
APP_ORIGIN=https://photos.example.com

# 管理员口令的 scrypt 哈希，格式 scrypt$<salt-hex>$<key-hex>。
# 生成方式：`pnpm setup`，或复用 apps/server/src/core/security 的 passwordHash()。
ADMIN_PASSWORD_HASH=

# 会话签名 / 凭据版本盐，至少 32 字符随机值（hex）。
# 生成：`openssl rand -hex 32`。
SESSION_SECRET=

# 数据目录（SQLite、原始/派生媒体、备份）。默认 <FANPHOTO_ROOT>/data。
FANPHOTO_DATA_DIR=

# 应用根目录：源码/发布根，用于定位迁移与静态构建。生产由 systemd 指定。
FANPHOTO_ROOT=.

# 可选：独立于 .env 的环境文件路径。
FANPHOTO_ENV_FILE=

# 监听地址与端口。默认 127.0.0.1:8787（仅本机反代可达）；不要直接暴露公网。
HOST=127.0.0.1
PORT=8787

# 生产需设为 production（关闭 localhost 开发 origin 例外）。
NODE_ENV=production

# 仅在由本机可信反代（Caddy 等）转发时开启，才会信任 X-Forwarded-For。
TRUST_LOCAL_PROXY=true