{
  "name": "fanphoto",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fanphoto/server --filter @fanphoto/client dev",
    "build": "pnpm typecheck && pnpm --filter @fanphoto/client build && node scripts/build-server.mjs",
    "typecheck": "tsc -p apps/server/tsconfig.json && tsc -p apps/client/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node apps/server/dist/server.mjs",
    "setup": "tsx scripts/setup.ts",
    "photos:import": "tsx scripts/import.ts",
    "backup": "tsx scripts/backup.ts",
    "format": "prettier --write apps packages scripts tests docs README.md"
  },
  "devDependencies": {
    "@fanphoto/contracts": "workspace:*",
    "sharp": "0.35.4",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
