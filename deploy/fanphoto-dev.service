[Unit]
Description=Fanphoto development deployment
After=network.target
ConditionPathExists=/home/ubuntu/fanphoto-dev/current/apps/api/dist/server.mjs

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fanphoto-dev/current
EnvironmentFile=/home/ubuntu/fanphoto-dev/.env
Environment=NODE_ENV=production
Environment=TRUST_LOCAL_PROXY=true
Environment=FANPHOTO_ROOT=/home/ubuntu/fanphoto-dev/current
ExecStart=/home/ubuntu/.nvm/versions/node/v24.19.0/bin/node apps/api/dist/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/fanphoto-dev/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=768M
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
